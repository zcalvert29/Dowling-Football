# Copy into the app's secrets: Streamlit Cloud -> Manage app -> Settings -> Secrets
# (or .streamlit/secrets.toml when running locally). Every entry is optional.

# Require a password to open the app.
app_password = "choose-something"

# Default opponent on the Home page and Scouting pages (must match the name in the data).
next_opponent = "SEP"

# Coach notes saved to a Google Sheet. Create a Google Cloud service account, share the
# sheet with its email address (Editor), and paste the service account's JSON key below.
notes_sheet_url = "https://docs.google.com/spreadsheets/d/your-sheet-id/edit"

[gcp_service_account]
type = "service_account"
project_id = "your-project"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "notes-bot@your-project.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
